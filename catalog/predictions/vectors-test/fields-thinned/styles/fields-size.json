{
  "version": 8,
  "name": "Field size (thinned)",
  "metadata": {
    "description": "Each 2025 predicted field colored by its own area, log-stepped bins (hectares) (0.1 ha to 1,000 ha)."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://data.source.coop/ftw/global-data/predictions/vectors-test/fields-2025-thinned.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fields-fill",
      "type": "fill",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "fill-color": [
          "step",
          [
            "/",
            [
              "get",
              "area"
            ],
            10000
          ],
          "#440154",
          1,
          "#3b528b",
          10,
          "#21918c",
          100,
          "#5ec962",
          1000,
          "#fde725"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "fields-outline",
      "type": "line",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "line-color": "#333333",
        "line-width": 0.3
      }
    }
  ]
}
