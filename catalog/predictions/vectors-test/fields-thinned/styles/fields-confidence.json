{
  "version": 8,
  "name": "Field confidence 2025 (thinned)",
  "metadata": {
    "description": "Per-field PRUE confidence (0-100); gray fields fall outside the modeled-confidence coverage."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://data.source.coop/ftw/global-data/predictions/vectors-test/fields-2025-thinned.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fields-confidence",
      "type": "fill",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "confidence"
          ],
          "#d73027",
          20,
          "#fdae61",
          40,
          "#ffffbf",
          60,
          "#a6d96a",
          80,
          "#1a9850"
        ],
        "fill-opacity": 0.55
      },
      "filter": [
        "==",
        [
          "typeof",
          [
            "get",
            "confidence"
          ]
        ],
        "number"
      ]
    },
    {
      "id": "fields-no-confidence",
      "type": "fill",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "fill-color": "#bdbdbd",
        "fill-opacity": 0.55
      },
      "filter": [
        "!",
        [
          "==",
          [
            "typeof",
            [
              "get",
              "confidence"
            ]
          ],
          "number"
        ]
      ]
    },
    {
      "id": "fields-outline",
      "type": "line",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "line-color": "#555",
        "line-width": 0.4
      }
    }
  ]
}
