{
  "version": 8,
  "name": "Field coverage (A5 r8)",
  "metadata": {
    "description": "Percent of each A5 resolution-8 cell (~519 km2 cells) covered by predicted fields (pct_covered; boundary fields count fully in their home cell)."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://data.source.coop/ftw/global-data/predictions/vectors-test/cells-2025-r8.pmtiles"
    }
  },
  "layers": [
    {
      "id": "cells-fill",
      "type": "fill",
      "source": "data",
      "source-layer": "cells",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_covered"
          ],
          "#ffffd9",
          5,
          "#edf8b1",
          15,
          "#7fcdbb",
          30,
          "#41b6c4",
          50,
          "#225ea8",
          80,
          "#081d58"
        ],
        "fill-opacity": 0.8
      }
    }
  ]
}
