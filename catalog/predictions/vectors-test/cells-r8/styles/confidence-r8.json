{
  "version": 8,
  "name": "Model confidence (A5 r8)",
  "metadata": {
    "description": "Mean per-cell PRUE confidence on A5 resolution-8 cells (~519 km2 cells); gray cells are in countries without modeled confidence."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://data.source.coop/ftw/global-data/predictions/vectors-test/cells-2025-r8.pmtiles"
    }
  },
  "layers": [
    {
      "id": "cells-confidence",
      "type": "fill",
      "source": "data",
      "source-layer": "cells",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "avg_confidence"
          ],
          "#d73027",
          20,
          "#fdae61",
          40,
          "#ffffbf",
          60,
          "#a6d96a",
          80,
          "#1a9850"
        ],
        "fill-opacity": 0.8
      },
      "filter": [
        "==",
        [
          "typeof",
          [
            "get",
            "avg_confidence"
          ]
        ],
        "number"
      ]
    },
    {
      "id": "cells-no-confidence",
      "type": "fill",
      "source": "data",
      "source-layer": "cells",
      "paint": {
        "fill-color": "#bdbdbd",
        "fill-opacity": 0.8
      },
      "filter": [
        "!",
        [
          "==",
          [
            "typeof",
            [
              "get",
              "avg_confidence"
            ]
          ],
          "number"
        ]
      ]
    }
  ]
}
